# THE JEY GANG STRATEGIST (JGS) — Environment Configuration
# Copy to .env.local when connecting a live PostgreSQL database or verified MT5 read-only bridge.
# Never expose secret keys with NEXT_PUBLIC_ prefix.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jgs_platform?schema=public"
AUTH_SECRET="replace-with-32-byte-cryptographic-secret"
JGS_TELEMETRY_MODE="DISCONNECTED"
MT5_READONLY_WEBHOOK_SECRET=""
